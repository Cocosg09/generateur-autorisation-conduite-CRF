# Réglages de production : copier en infra/.env sur le VPS (jamais versionné).

# --- Connexion à l'espace gestion avec son compte Gestion des DPS ---------
# Interface de serveur à serveur (réseau Docker infra_interne).
GESTION_DPS_URL=http://gestion_dps_backend:3000/integrations/autorisation-conduite
# Même valeur que INTEGRATION_AUTORISATION_CONDUITE_TOKEN dans /opt/gestion-dps/backend/.env
GESTION_DPS_TOKEN=
# Adresse publique de l'interface web de Gestion des DPS (page de connexion).
GESTION_DPS_URL_INTERFACE=
# Comptes Gestion des DPS autorisés dans l'espace gestion (e-mails, séparés par des virgules).
GESTIONNAIRES=

# --- Structure (texte du document) et boîte du RTPA ------------------------
RTPA_FONCTION=RTPA
RTPA_STRUCTURE=DT DE L'ARIEGE
# Reçoit l'avis de chaque nouvelle demande et une copie des autorisations signées.
RTPA_EMAIL=rtpa.dt09@croix-rouge.fr

# --- E-mails (serveur SMTP du VPS) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Autorisation de conduite <no-reply@croix-rouge-ariege.fr>

# Durée de conservation des demandes, en jours.
RETENTION_JOURS=400
